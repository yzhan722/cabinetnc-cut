{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cabinetnc.local/schema/manufacturing-snapshot-v1.schema.json",
  "title": "CabinetNC Manufacturing Snapshot",
  "type": "object",
  "required": ["schema", "schemaVersion", "jobId", "units", "workpieces"],
  "properties": {
    "schema": { "const": "cabinetnc.manufacturing-snapshot" },
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "jobId": { "type": "string", "minLength": 1 },
    "units": { "const": "mm" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "properties": {
        "cadApp": { "type": "string" },
        "pluginId": { "type": "string" },
        "pluginVersion": { "type": "string" },
        "designName": { "type": "string" },
        "designRevision": { "type": "string" }
      },
      "additionalProperties": true
    },
    "materials": {
      "type": "array",
      "items": { "$ref": "#/$defs/material" }
    },
    "workpieces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workpiece" }
    },
    "relationships": {
      "type": "array",
      "items": { "type": "object" }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["info", "warning", "error"] },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "entityId": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false
    },
    "profile": {
      "type": "object",
      "required": ["points"],
      "properties": {
        "closed": { "const": true },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point" }
        }
      },
      "additionalProperties": true
    },
    "material": {
      "type": "object",
      "required": ["materialId"],
      "properties": {
        "materialId": { "type": "string", "minLength": 1 },
        "substrateId": { "type": "string" },
        "displayName": { "type": "string" },
        "thicknessMm": { "type": "number", "exclusiveMinimum": 0 },
        "decorId": { "type": "string" }
      },
      "additionalProperties": true
    },
    "finish": {
      "type": "object",
      "required": ["finishId"],
      "properties": {
        "finishId": { "type": "string", "minLength": 1 },
        "finishName": { "type": "string" }
      },
      "additionalProperties": true
    },
    "face": {
      "type": "object",
      "required": ["faceId"],
      "properties": {
        "faceId": { "enum": ["A", "B"] },
        "role": { "type": "string" },
        "finish": { "$ref": "#/$defs/finish" },
        "machiningPermission": {
          "enum": ["PRIMARY", "ALLOWED", "NOT_ALLOWED", "UNASSIGNED"]
        }
      },
      "additionalProperties": true
    },
    "featureGeometry": {
      "type": "object",
      "properties": {
        "center": { "$ref": "#/$defs/point" },
        "diameterMm": { "type": "number", "exclusiveMinimum": 0 },
        "centerline": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/point" }
        },
        "widthMm": { "type": "number", "exclusiveMinimum": 0 },
        "profile": { "$ref": "#/$defs/profile" }
      },
      "additionalProperties": true
    },
    "feature": {
      "type": "object",
      "required": ["featureId", "kind", "sourceFace", "geometry", "through"],
      "properties": {
        "featureId": { "type": "string", "minLength": 1 },
        "groupId": { "type": "string" },
        "kind": {
          "enum": [
            "bore",
            "groove",
            "pocket",
            "throughProfile",
            "counterbore",
            "countersink",
            "edgeRabbet",
            "custom"
          ]
        },
        "sourceFace": { "enum": ["A", "B", "THROUGH", "UNKNOWN"] },
        "geometry": { "$ref": "#/$defs/featureGeometry" },
        "depthMm": { "type": "number", "exclusiveMinimum": 0 },
        "through": { "type": "boolean" },
        "intent": {
          "type": "object",
          "properties": {
            "purpose": { "type": "string" },
            "operationType": { "type": "string" },
            "sourceRelationshipId": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "workpiece": {
      "type": "object",
      "required": ["workpieceId", "material", "geometry", "features"],
      "properties": {
        "workpieceId": { "type": "string", "minLength": 1 },
        "panelId": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 1 },
        "identity": {
          "type": "object",
          "properties": {
            "projectId": { "type": "string" },
            "moduleId": { "type": "string" },
            "role": { "type": "string" }
          },
          "additionalProperties": true
        },
        "material": {
          "type": "object",
          "required": ["materialId", "thicknessMm"],
          "properties": {
            "materialId": { "type": "string", "minLength": 1 },
            "thicknessMm": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": true
        },
        "geometry": {
          "type": "object",
          "required": ["quality", "outerProfile"],
          "properties": {
            "quality": { "enum": ["exact", "tessellated", "bboxFallback"] },
            "toleranceMm": { "type": "number", "exclusiveMinimum": 0 },
            "outerProfile": { "$ref": "#/$defs/profile" },
            "innerProfiles": {
              "type": "array",
              "items": { "$ref": "#/$defs/profile" }
            },
            "nestingPolygon": {
              "type": "array",
              "minItems": 3,
              "items": { "$ref": "#/$defs/point" }
            }
          },
          "additionalProperties": true
        },
        "faces": {
          "type": "array",
          "items": { "$ref": "#/$defs/face" }
        },
        "features": {
          "type": "array",
          "items": { "$ref": "#/$defs/feature" }
        },
        "manufacturing": {
          "type": "object",
          "properties": {
            "mode": { "const": "singleSide" },
            "machiningFace": { "enum": ["A", "B", "EITHER"] }
          },
          "additionalProperties": true
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
