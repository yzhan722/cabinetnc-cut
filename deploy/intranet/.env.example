# Copy to .env in this directory, then replace EVERY placeholder. .env is git-ignored; never commit it.
# Generate secrets, e.g.:  openssl rand -base64 48     (PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]]))

# PostgreSQL (not reachable from the LAN; only api/worker on the internal network)
POSTGRES_DB=cabinetnc
POSTGRES_USER=cabinetnc
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# MinIO root credentials = the credentials api/worker use for the object store (not reachable from the LAN)
MINIO_ROOT_USER=CHANGE_ME_minio_access_key
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret_key_min_8_chars
CABINETNC_OBJECTSTORE_BUCKET=cabinetnc

# JWT signing key: random, 32..4096 bytes (64 recommended). The API refuses to start with a short value.
CABINETNC_JWT_SIGNING_KEY=CHANGE_ME_random_64_bytes

# First-start admin. Set all three together, log in once, then DELETE all three and `docker compose up -d`.
CABINETNC_BOOTSTRAP_TENANT=shop
CABINETNC_BOOTSTRAP_ADMIN_EMAIL=admin@example.internal
CABINETNC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_min_12_chars

# DNS name Desktop machines use for the API; also the certificate subject.
CABINETNC_PUBLIC_HOST=cabinetnc.intranet.local

# Worker identity (must differ per worker instance) and lease/poll tuning
CABINETNC_WORKER_ID=worker-1
CABINETNC_WORKER_LEASE_SECONDS=300
CABINETNC_WORKER_POLL_SECONDS=1

# Optional: stamp images with the git revision they were built from (recorded as EngineVersion on jobs)
SOURCE_REVISION=
CABINETNC_IMAGE_TAG=local
