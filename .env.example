# OmniCam cloud storage (Phase 1 — local-first mirror).
# Same variable names as Cab Lab (the-cab-lab/.env.example). Never commit
# real values — .env* is gitignored.
#
# Alternatively point CAB_CLOUD_CONFIG at a JSON file with the same keys
# (enabled, provider, gcpProjectId, gcpBucket, gcpRegion, gcpCredentialsFile,
# gcpAccessToken, localRoot).

CAB_CLOUD_ENABLED=0
CAB_CLOUD_PROVIDER=gcp
CAB_CLOUD_ROOT=omnicam
CAB_GCP_PROJECT_ID=cab-platform-dev
CAB_GCP_BUCKET=
CAB_GCP_REGION=asia-southeast1

# Auth — first match wins:
#   1. explicit bearer token (short-lived, dev/tests)
#   2. service-account key JSON
#   3. gcloud application-default credentials
#   4. `gcloud auth … print-access-token` subprocess
# CAB_GCP_ACCESS_TOKEN=
# CAB_GCP_CREDENTIALS=C:/secrets/cab-platform-dev-sa.json

# provider=local mirrors the bucket layout into a directory instead of GCS.
# CAB_CLOUD_LOCAL_ROOT=D:/cab-cloud-local
