<Window x:Class="CabinetNC.Desktop.PanelDraftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="创建板件"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1100" Height="740"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#000000"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowKey">
  <Window.Resources>
    <Style x:Key="CadStatusChip" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#5A5A5A" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}"
                       Foreground="{TemplateBinding Foreground}"
                       FontFamily="{TemplateBinding FontFamily}"
                       FontSize="{TemplateBinding FontSize}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tx" Property="Foreground" Value="#E8C84A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CadCombo" TargetType="ComboBox">
      <Setter Property="Background" Value="#1A1A1A" />
      <Setter Property="Foreground" Value="#E8E8E8" />
      <Setter Property="BorderBrush" Value="#3A3A3A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="IsEditable" Value="False" />
    </Style>
    <Style x:Key="CadBarBtn" TargetType="Button">
      <Setter Property="Background" Value="#2A2A2A" />
      <Setter Property="Foreground" Value="#D0D0D0" />
      <Setter Property="BorderBrush" Value="#3A3A3A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="CadToolBtn" TargetType="ToggleButton">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Background" Value="#1E1E1E" />
      <Setter Property="BorderBrush" Value="#3A3A3A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1A3A5C" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3D7AB5" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#6A6A6A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CadModeBtn" TargetType="ToggleButton">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="4,6" />
      <Setter Property="Background" Value="#1E1E1E" />
      <Setter Property="Foreground" Value="#C8C8C8" />
      <Setter Property="BorderBrush" Value="#3A3A3A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1A3A5C" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3D7AB5" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#6A6A6A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#2B2B2B" BorderBrush="#111111" BorderThickness="0,0,0,1" Padding="10,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="编号" Foreground="#8A8A8A" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox x:Name="DraftIdBox" Width="96" Margin="0,0,10,0" Padding="4,2"
                   Background="#1A1A1A" Foreground="#E8E8E8" BorderBrush="#3A3A3A"
                   CaretBrush="#E8C84A" FontFamily="Consolas" FontSize="12" />
          <TextBlock Text="名称" Foreground="#8A8A8A" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox x:Name="DraftNameBox" Width="120" Margin="0,0,10,0" Padding="4,2"
                   Background="#1A1A1A" Foreground="#E8E8E8" BorderBrush="#3A3A3A"
                   CaretBrush="#E8C84A" FontSize="12" />
          <TextBlock Text="板材" Foreground="#8A8A8A" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox x:Name="DraftKindCombo" Width="220" Margin="0,0,12,0"
                    Style="{StaticResource CadCombo}"
                    DisplayMemberPath="Label"
                    ToolTip="方案里已有的材料种类（含厚度）" />
          <Button x:Name="CommitBtn" Content="加入方案" Style="{StaticResource CadBarBtn}"
                  Click="OnCommitClick" Margin="0,0,8,0" FontWeight="SemiBold" />
          <Button Content="关闭" Style="{StaticResource CadBarBtn}"
                  Click="OnCloseClick" Margin="0" />
        </StackPanel>
        <TextBlock Text="模型空间 · 毫米 · 滚轮缩放 · 中键平移" Foreground="#9A9A9A" FontSize="12"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Background="#222222" BorderBrush="#111111" BorderThickness="0,0,0,1" Padding="8,4">
      <StackPanel Orientation="Horizontal">
        <ToggleButton x:Name="ToolLine" Style="{StaticResource CadToolBtn}"
                      Click="OnToolLineClick" ToolTip="Line (L) · 连续画线；拖动时 Tab 输入相对 ΔX/ΔY 并锁定">
          <Canvas Width="22" Height="18">
            <Rectangle Canvas.Left="1" Canvas.Top="12" Width="4" Height="4" Fill="#E8E8E8" />
            <Rectangle Canvas.Left="16" Canvas.Top="1" Width="4" Height="4" Fill="#E8E8E8" />
            <Line X1="5" Y1="14" X2="16" Y2="5" Stroke="#E8E8E8" StrokeThickness="1.4" />
          </Canvas>
        </ToggleButton>
        <ToggleButton x:Name="ToolRect" Style="{StaticResource CadToolBtn}"
                      Click="OnToolRectClick"
                      ToolTip="Rectangle (REC) · 左键画矩形；右键切换角点/中心">
          <ToggleButton.ContextMenu>
            <ContextMenu Background="#2B2B2B" BorderBrush="#3A3A3A" Foreground="#E8E8E8"
                         Opened="OnRectMenuOpened">
              <MenuItem x:Name="RectMenuCorner" Header="角点到角点 (Corner)"
                        IsCheckable="True" Click="OnRectCornerMode" />
              <MenuItem x:Name="RectMenuCenter" Header="中心到角点 (Center)"
                        IsCheckable="True" Click="OnRectCenterMode" />
            </ContextMenu>
          </ToggleButton.ContextMenu>
          <Rectangle Width="18" Height="12" Stroke="#E8E8E8" StrokeThickness="1.4" />
        </ToggleButton>
        <ToggleButton x:Name="ToolCircle" Style="{StaticResource CadToolBtn}"
                      Click="OnToolCircleClick"
                      ToolTip="Circle (CIRCLE) · 默认圆心到边上；右键切边上到边上">
          <ToggleButton.ContextMenu>
            <ContextMenu Background="#2B2B2B" BorderBrush="#3A3A3A" Foreground="#E8E8E8"
                         Opened="OnCircleMenuOpened">
              <MenuItem x:Name="CircleMenuCenter" Header="圆心到边上 (Center → Edge)"
                        IsCheckable="True" Click="OnCircleCenterMode" />
              <MenuItem x:Name="CircleMenuDiameter" Header="边上到边上 (Edge → Edge)"
                        IsCheckable="True" Click="OnCircleDiameterMode" />
            </ContextMenu>
          </ToggleButton.ContextMenu>
          <Ellipse Width="16" Height="16" Stroke="#E8E8E8" StrokeThickness="1.4" />
        </ToggleButton>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#1A1A1A" BorderBrush="#111111" BorderThickness="0,1,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#252525" Padding="10,3">
          <StackPanel Orientation="Horizontal">
            <ToggleButton x:Name="SnapChip" Content="SNAP" Style="{StaticResource CadStatusChip}"
                          IsChecked="True" Click="OnSnapChip" ToolTip="网格捕捉 (F9)" />
            <ToggleButton x:Name="OrthoChip" Content="ORTHO" Style="{StaticResource CadStatusChip}"
                          Click="OnOrthoChip" ToolTip="正交 90° (F8)" />
            <TextBlock Text="GRID" Foreground="#E8C84A" FontSize="11" FontFamily="Consolas"
                       Margin="0,0,14,0" VerticalAlignment="Center" />
            <TextBlock Text="MODEL" Foreground="#E8C84A" FontSize="11" FontFamily="Consolas"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <StackPanel Margin="10,8,10,6">
          <TextBlock x:Name="CommandPrompt" Text="命令:"
                     Foreground="#E8C84A" FontFamily="Consolas" FontSize="12" />
          <TextBox x:Name="CommandBox"
                   Background="#000000" Foreground="#E8E8E8"
                   BorderBrush="#333333" CaretBrush="#E8C84A"
                   FontFamily="Consolas" FontSize="13" Padding="6,4" Margin="0,4,0,0"
                   PreviewKeyDown="OnCommandKey"
                   TextChanged="OnCommandTextChanged" />
        </StackPanel>
      </DockPanel>
    </Border>

    <DockPanel>
      <Border DockPanel.Dock="Left" Width="72" Background="#1A1A1A"
              BorderBrush="#111111" BorderThickness="0,0,1,0" Padding="8,10">
        <StackPanel>
          <ToggleButton x:Name="ModeProfile" Style="{StaticResource CadModeBtn}"
                        IsChecked="True" Click="OnModeClick"
                        ToolTip="Profile · 板件本体 / 外框">
            <StackPanel HorizontalAlignment="Center">
              <Rectangle Width="26" Height="16" Stroke="#5AA8E8" StrokeThickness="1.5"
                         HorizontalAlignment="Center" Margin="0,0,0,4" />
              <TextBlock Text="Profile" FontSize="9" HorizontalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="ModeFeature" Style="{StaticResource CadModeBtn}"
                        Click="OnModeClick"
                        ToolTip="Feature · 不切透的槽 / 口袋 / 孔">
            <StackPanel HorizontalAlignment="Center">
              <Grid Width="26" Height="16" HorizontalAlignment="Center" Margin="0,0,0,4">
                <Rectangle Stroke="#E24A4A" StrokeThickness="1.2" />
                <Ellipse Width="7" Height="7" Stroke="#E24A4A" StrokeThickness="1.2"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="Feature" FontSize="9" HorizontalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="ModeGuide" Style="{StaticResource CadModeBtn}"
                        Click="OnModeClick"
                        ToolTip="辅助线 · 只作参考，不进刀路。右键可删除全部。">
            <ToggleButton.ContextMenu>
              <ContextMenu Background="#2B2B2B" BorderBrush="#3A3A3A" Foreground="#E8E8E8">
                <MenuItem Header="删除所有辅助线" Click="OnClearAllGuides" />
              </ContextMenu>
            </ToggleButton.ContextMenu>
            <StackPanel HorizontalAlignment="Center">
              <Canvas Width="26" Height="16" HorizontalAlignment="Center" Margin="0,0,0,4">
                <Line X1="2" Y1="14" X2="24" Y2="2" Stroke="#3CBF5A" StrokeThickness="1.4"
                      StrokeDashArray="3 2" />
              </Canvas>
              <TextBlock Text="辅助线" FontSize="9" HorizontalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            </StackPanel>
          </ToggleButton>
        </StackPanel>
      </Border>
      <skia:SKElement x:Name="DraftHost" PaintSurface="OnPaintSurface"
                      IgnorePixelScaling="False"
                      MouseLeftButtonDown="OnDraftDown"
                      MouseRightButtonDown="OnDraftRightDown"
                      MouseDown="OnDraftMouseDown"
                      MouseUp="OnDraftMouseUp"
                      MouseMove="OnDraftMove"
                      MouseLeave="OnDraftMouseLeave"
                      PreviewMouseWheel="OnDraftWheel" />
    </DockPanel>
  </DockPanel>
</Window>
