<Window x:Class="CabinetNC.Desktop.OverrideReasonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预检未通过 — 仍要导出？"
        Width="560" SizeToContent="Height" MinHeight="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="22"
                 Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0" VerticalAlignment="Top" />
      <StackPanel>
        <TextBlock Text="预检发现下列问题" Style="{StaticResource H2Text}" />
        <TextBlock Text="这些不是硬错误，可以强制导出；但机床会按这份程序运动。写下你为什么确认它是安全的，这段话会进入使用日志。"
                   Style="{StaticResource SecondaryText}" Margin="0,4,0,0" MaxWidth="470" />
      </StackPanel>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock Text="强制导出的原因（至少 6 个字）" Style="{StaticResource FieldLabel}" />
      <TextBox x:Name="ReasonBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
               VerticalContentAlignment="Top" TextChanged="OnReasonChanged"
               ToolTip="例如：槽深超出是设计要求，已与设计师确认；或：警告来自余料边，实物已核对" />
      <DockPanel Margin="0,12,0,0">
        <Button DockPanel.Dock="Right" Content="取消" IsCancel="True" Padding="16,6" Margin="8,0,0,0" />
        <Button x:Name="ConfirmBtn" DockPanel.Dock="Right" Content="记录原因并导出" Click="OnConfirmClick"
                Style="{StaticResource DangerButton}" Padding="16,6" IsEnabled="False" />
        <TextBlock Text="导出后请在上机检查单里再核对一次。" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
      </DockPanel>
    </StackPanel>

    <Border Style="{StaticResource Card}" Margin="0">
      <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="IssuesText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource TextBrush}" />
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
