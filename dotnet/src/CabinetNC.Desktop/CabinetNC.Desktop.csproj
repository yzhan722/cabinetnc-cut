<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CabinetNC.Compute.Contracts\CabinetNC.Compute.Contracts.csproj" />
    <ProjectReference Include="..\CabinetNC.Domain\CabinetNC.Domain.csproj" />
    <ProjectReference Include="..\CabinetNC.FusionPackage\CabinetNC.FusionPackage.csproj" />
    <ProjectReference Include="..\CabinetNC.Application\CabinetNC.Application.csproj" />
    <ProjectReference Include="..\CabinetNC.Desktop.Core\CabinetNC.Desktop.Core.csproj" />
    <ProjectReference Include="..\CabinetNC.ComputeWorker\CabinetNC.ComputeWorker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CabinetNC.Infrastructure\CabinetNC.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- Copy ComputeWorker next to Desktop and into dist. MSBuild globs plus
       PublishDir-as-dest previously dropped CabinetNC.ComputeWorker.dll, so
       the desktop shortcut spawned an exe that exited immediately. -->
  <Target Name="CopyWorker" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_WorkerOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\CabinetNC.ComputeWorker\bin\$(Configuration)\net10.0'))</_WorkerOut>
      <_DesktopOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(OutputPath)'))</_DesktopOut>
      <_LaunchOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\dist\CabinetNC-Cut'))</_LaunchOut>
    </PropertyGroup>
    <Error Text="ComputeWorker output missing: $(_WorkerOut)\CabinetNC.ComputeWorker.dll"
           Condition="!Exists('$(_WorkerOut)\CabinetNC.ComputeWorker.dll')" />
    <MakeDir Directories="$(_DesktopOut)" />
    <Exec Command="powershell -NoProfile -Command Copy-Item -Path '$(_WorkerOut)\*' -Destination '$(_DesktopOut)' -Recurse -Force"
          IgnoreExitCode="false" />
    <Error Text="CopyWorker missed CabinetNC.ComputeWorker.dll under $(_DesktopOut)"
           Condition="!Exists('$(_DesktopOut)\CabinetNC.ComputeWorker.dll')" />
    <MakeDir Directories="$(_LaunchOut)" Condition="'$(Configuration)' == 'Release'" />
    <Exec Command="powershell -NoProfile -Command Copy-Item -Path '$(_WorkerOut)\*' -Destination '$(_LaunchOut)' -Recurse -Force"
          IgnoreExitCode="false"
          Condition="'$(Configuration)' == 'Release'" />
    <Error Text="CopyWorker missed CabinetNC.ComputeWorker.dll under $(_LaunchOut)"
           Condition="'$(Configuration)' == 'Release' AND !Exists('$(_LaunchOut)\CabinetNC.ComputeWorker.dll')" />
  </Target>

  <!-- One user-facing build: desktop shortcut launches dist\CabinetNC-Cut. -->
  <Target Name="CopyToDesktopLaunch" AfterTargets="CopyWorker"
          Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_DesktopLaunch>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\dist\CabinetNC-Cut\'))</_DesktopLaunch>
    </PropertyGroup>
    <ItemGroup>
      <_LaunchFiles Include="$(OutputPath)*" Exclude="$(OutputPath)publish\**\*" />
      <_LaunchFiles Include="$(OutputPath)**\*" Exclude="$(OutputPath)publish\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(_DesktopLaunch)" />
    <Copy SourceFiles="@(_LaunchFiles)"
          DestinationFiles="@(_LaunchFiles->'$(_DesktopLaunch)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Retries="3"
          RetryDelayMilliseconds="400" />
    <Message Importance="high" Text="Updated desktop launch folder: $(_DesktopLaunch)" />
  </Target>

</Project>
