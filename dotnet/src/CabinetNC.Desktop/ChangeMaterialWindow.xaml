<Window x:Class="CabinetNC.Desktop.ChangeMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="改变材料"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F7F7"
        FontFamily="Segoe UI">
  <StackPanel Margin="18,16,18,16">
    <TextBlock x:Name="LeadText" Text="将板件改为" FontWeight="SemiBold" Foreground="#12314F" Margin="0,0,0,8" />
    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="KindList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton GroupName="TargetKind"
                         Content="{Binding Display}"
                         Tag="{Binding}"
                         Checked="OnKindChecked"
                         Margin="0,4,0,0"
                         FontSize="13" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel x:Name="BlindPane" Margin="0,16,0,0" Visibility="Collapsed">
      <TextBlock Text="半槽 / 铰链孔" FontWeight="SemiBold" Foreground="#12314F" />
      <RadioButton x:Name="BlindKeep" GroupName="Blind" Content="保持原数值" IsChecked="True" Margin="0,6,0,0" />
      <RadioButton x:Name="BlindScale" GroupName="Blind" Content="随厚度调整" Margin="0,4,0,0" />
    </StackPanel>

    <TextBlock Text="通孔、通槽将按新厚度重写深度。改完后可继续改其他板，再点「重新密排」。"
               Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="取消" IsCancel="True" Width="84" Margin="0,0,8,0" Click="OnCancel" />
      <Button Content="确定" IsDefault="True" Width="84" FontWeight="SemiBold" Click="OnOk" />
    </StackPanel>
  </StackPanel>
</Window>
