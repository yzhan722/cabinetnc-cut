                                 ToolTip="小于此值才钻孔；等于或更大走清底。默认 5。钻头只钻不铣。" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666" Margin="0,0,0,8"
                                   Text="不选手动刀号，孔径跟钻头走。孔间 G0。盲孔深度跟 CAD。大于阈值的孔（含铰杯）走 Area Clearance。" />
                        <TextBlock x:Name="DrillSummary" Text="" FontSize="10" Foreground="#666" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel x:Name="OpsParamsGuillotine" Visibility="Collapsed">
                        <Border BorderBrush="#C45A00" BorderThickness="1" Padding="8" Background="#FFF8F0">
                          <StackPanel>
                            <TextBlock Text="Guillotine cut" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#8A3E00" Margin="0,0,0,8" />
                            <TextBlock Text="Feedrate (mm/min)" FontSize="10" Foreground="#666" />
                            <TextBox x:Name="GuillotineFeed" Text="9000" Margin="0,0,0,6"
                                     LostFocus="OnGuillotineFieldChanged" />
                            <TextBlock Text="Plunge rate (mm/min)" FontSize="10" Foreground="#666" />
                            <TextBox x:Name="GuillotinePlunge" Text="1000" Margin="0,0,0,6"
                                     LostFocus="OnGuillotineFieldChanged" />
                            <TextBlock Text="探底深度 (mm)" FontSize="10" Foreground="#666" />
                            <TextBox x:Name="GuillotineThrough" Text="-0.55" Margin="0,0,0,0"
                                     LostFocus="OnGuillotineFieldChanged"
                                     ToolTip="余料分割线贯通下探。默认 -0.55。" />
                          </StackPanel>
                        </Border>
                      </StackPanel>

                      <StackPanel Visibility="Collapsed">
                        <CheckBox x:Name="OpsTongueChk" IsChecked="True" Click="OnCamStrategyEnableClick" />
                        <CheckBox x:Name="OpsProfileChk" IsChecked="True" Click="OnCamStrategyEnableClick" />
                        <CheckBox x:Name="OpsProfileLastChk" IsChecked="True" Click="OnCamStrategyEnableClick" />
                        <CheckBox x:Name="OpsBridgeChk" IsChecked="True" Click="OnCamStrategyEnableClick" />
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </DockPanel>
            </Border>

