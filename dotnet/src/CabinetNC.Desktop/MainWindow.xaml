                  <TextBlock x:Name="NcPaneTitle" Text="刀路文件" FontWeight="SemiBold" Foreground="#333" />
                  <TextBlock x:Name="OutOpsMeta" Text="" FontSize="11" Foreground="#666" Margin="0,4,0,0" TextWrapping="Wrap" />
                  <TextBlock Text="Ctrl 多选 · Shift 连选" FontSize="10" Foreground="#999" Margin="0,2,0,0" />
                  <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="PreflightMeta" />
                    <WrapPanel x:Name="OutExportPanel">
                      <Button x:Name="OutPreflightBtn" Click="OnPreflightClick" />
                      <Button x:Name="OutSaveNcBtn" Click="OnSaveNcClick" />
                      <Button x:Name="OutDxfBtn" Click="OnExportDxfClick" />
                      <Button x:Name="OutJobSheetBtn" Click="OnExportJobSheetClick" />
                      <Button x:Name="OutJsonBtn" Click="OnExportJsonClick" />
                      <Button x:Name="OutBundleBtn" Click="OnExportBundleClick" />
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
                  <Button x:Name="OutExportSelectedBtn" Content="导出当前大板" Click="OnExportSelectedClick"
