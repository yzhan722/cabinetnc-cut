                    <ComboBox x:Name="NestEngineCombo" SelectedIndex="0" Margin="0,0,0,8">
                      <ComboBoxItem Tag="nfp" Content="推荐精排（异形友好）" />
                      <ComboBoxItem Tag="blf" Content="快速矩形" />
                      <ComboBoxItem Tag="deepnest" Content="实验预览（较慢）" />
                    </ComboBox>
                    <TextBlock Text="机型" FontSize="11" Foreground="#555" />
                    <ComboBox x:Name="MachineCombo" DisplayMemberPath="Name" SelectedValuePath="Id"
                              Margin="0,0,0,10" SelectionChanged="OnNestMachineChanged" />
                    <TextBlock Text="排版结果" Style="{StaticResource RailH2}" />
                    <TextBlock x:Name="NestReportMeta" Text="尚未排版" TextWrapping="Wrap" FontSize="12"
                               Foreground="#222" Margin="0,2,0,6" />
                    <TextBlock Text="按材料" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,2,0,2" />
                    <ItemsControl x:Name="NestGroupReportList" Margin="0,0,0,8" />
                    <Expander x:Name="NestWarningsExpander" Header="未排 / 警告" FontSize="12" IsExpanded="False">
                      <ListBox x:Name="NestUnplacedList" BorderThickness="0" Background="Transparent"
                               FontSize="11" Margin="0,4,0,0" MaxHeight="180" />
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>

            <Border x:Name="OpsPane" Grid.Column="2" Background="#F7F7F7" BorderBrush="#C8C8C8"
                    BorderThickness="1,0,0,0" Padding="0" Visibility="Collapsed">
              <DockPanel>
                <!-- Far-right icon rail: machine, 3 toolpaths, calculate -->
                <Border DockPanel.Dock="Right" Width="88" Background="#EEEEEE"
                        BorderBrush="#C8C8C8" BorderThickness="1,0,0,0" Padding="8,10,8,10">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                      <TextBlock Text="机型" FontSize="10" Foreground="#555" HorizontalAlignment="Center"
                                 Margin="0,0,0,4" />
                      <ComboBox x:Name="OpsMachineCombo" DisplayMemberPath="Name" SelectedValuePath="Id"
                                FontSize="10" Margin="0,0,0,12"
                                SelectionChanged="OnOpsMachineChanged" />
                      <ToggleButton x:Name="OpsIconProfile" Style="{StaticResource OpsIconBtn}"
                                    Tag="Profile" Click="OnOpsToolpathIconClick"
                                    ToolTip="Profiling · 外形 / 开窗 / 半槽">
                        <StackPanel HorizontalAlignment="Center">
                          <Rectangle Width="34" Height="22" Stroke="#2277CC" StrokeThickness="2"
                                     HorizontalAlignment="Center" Margin="0,0,0,4" />
                          <TextBlock Text="Profiling" FontSize="9" HorizontalAlignment="Center"
                                     TextAlignment="Center" TextWrapping="Wrap" />
                          <TextBlock x:Name="OpsIconProfileCount" Text="" FontSize="9" Opacity="0.75"
                                     HorizontalAlignment="Center" />
                        </StackPanel>
                      </ToggleButton>
                      <ToggleButton x:Name="OpsIconClearance" Style="{StaticResource OpsIconBtn}"
                                    Tag="AreaClearance" Click="OnOpsToolpathIconClick"
                                    ToolTip="Area Clearance · 口袋 / 宽槽清底">
                        <StackPanel HorizontalAlignment="Center">
                          <Border Width="34" Height="22" Background="#3D9A5F" Opacity="0.85"
                                  BorderBrush="#2E7A4A" BorderThickness="1" HorizontalAlignment="Center"
                                  Margin="0,0,0,4" />
                          <TextBlock Text="Area Clearance" FontSize="9" HorizontalAlignment="Center"
                                     TextAlignment="Center" TextWrapping="Wrap" />
                          <TextBlock x:Name="OpsIconClearanceCount" Text="" FontSize="9" Opacity="0.75"
                                     HorizontalAlignment="Center" />
                        </StackPanel>
                      </ToggleButton>
                      <ToggleButton x:Name="OpsIconDrill" Style="{StaticResource OpsIconBtn}"
                                    Tag="Drilling" Click="OnOpsToolpathIconClick"
                                    ToolTip="Drilling · 孔">
                        <StackPanel HorizontalAlignment="Center">
                          <Ellipse Width="16" Height="16" Stroke="#8B5A2B" StrokeThickness="2"
                                   Fill="#D4A574" HorizontalAlignment="Center" Margin="0,0,0,4" />
                          <TextBlock Text="Drilling" FontSize="9" HorizontalAlignment="Center" />
                          <TextBlock x:Name="OpsIconDrillCount" Text="" FontSize="9" Opacity="0.75"
                                     HorizontalAlignment="Center" />
                        </StackPanel>
                      </ToggleButton>
                      <ToggleButton x:Name="OpsIconGuillotine" Style="{StaticResource OpsIconBtn}"
                                    Tag="Guillotine" Click="OnOpsToolpathIconClick"
                                    Visibility="Collapsed"
                                    ToolTip="Guillotine cut · 界面二的余料分割线">
                        <StackPanel HorizontalAlignment="Center">
                          <Canvas Width="34" Height="22" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Line X1="6" Y1="4" X2="6" Y2="18" Stroke="#C45A00" StrokeThickness="2"
                                  StrokeDashArray="2 1.5" />
                            <Line X1="6" Y1="18" X2="28" Y2="18" Stroke="#C45A00" StrokeThickness="2"
                                  StrokeDashArray="2 1.5" />
                          </Canvas>
                          <TextBlock Text="Guillotine" FontSize="9" HorizontalAlignment="Center"
                                     TextAlignment="Center" TextWrapping="Wrap" />
                          <TextBlock x:Name="OpsIconGuillotineCount" Text="" FontSize="9" Opacity="0.75"
                                     HorizontalAlignment="Center" />
                        </StackPanel>
                      </ToggleButton>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                      <CheckBox x:Name="OpsHomeXyChk" IsChecked="True" FontSize="10"
                                Margin="0,0,0,8" Click="OnOpsHomeXyClick"
                                ToolTip="程序结束先 G0 X0 Y0 再 G80。默认开。">
                        <TextBlock Text="结束回原点" TextWrapping="Wrap" FontSize="10" />
                      </CheckBox>
                      <Button Style="{StaticResource OpsRailCalcBtn}" Click="OnOpsCalculateCurrentClick"
                              ToolTip="只算当前大板，不重新密排">
                        <TextBlock Text="计算当前板材" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" />
                      </Button>
                      <Button Style="{StaticResource OpsRailCalcPrimaryBtn}" Click="OnOpsCalculateAllClick"
                              ToolTip="算全部大板，不重新密排；完成后可进入「5 导出」">
                        <TextBlock Text="计算全部" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" />
                      </Button>
                    </StackPanel>
                    <TextBlock />
                  </DockPanel>
                </Border>

                <!-- Params inspector: appears left of the icon rail when an icon is selected -->
                <Border x:Name="OpsParamsPane" Width="300" Visibility="Collapsed"
                        Background="#F7F7F7" Padding="10">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <TextBlock x:Name="OpsParamsTitle" Text="Profiling" Style="{StaticResource RailH2}" Margin="0,0,0,8" />

                      <StackPanel x:Name="OpsParamsProfile">
                        <TextBlock Text="半槽 T1" FontSize="12" FontWeight="SemiBold" Foreground="#1A3A5C" Margin="0,0,0,6" />
                        <TextBlock Text="Feedrate (mm/min)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="TongueFeed" Text="9000" Margin="0,0,0,6" LostFocus="OnProfileFieldChanged"
                                 ToolTip="T1 半槽进给，可改。默认 9000。" />
                        <TextBlock Text="转速 (rpm)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="TongueRpm" Text="14500" Margin="0,0,0,6" LostFocus="OnProfileFieldChanged" />
                        <TextBlock Text="Plunge rate (mm/min)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="TonguePlunge" Text="1000" Margin="0,0,0,12" LostFocus="OnProfileFieldChanged" />

                        <TextBlock Text="第一刀" FontSize="12" FontWeight="SemiBold" Foreground="#1A3A5C" Margin="0,0,0,6" />
                        <TextBlock Text="刀" FontSize="10" Foreground="#666" />
                        <ComboBox x:Name="ProfFirstTool" Margin="0,0,0,6" SelectionChanged="OnProfileToolChanged" />
                        <TextBlock Text="Feedrate (mm/min)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ProfFirstFeed" Text="12000" Margin="0,0,0,6" LostFocus="OnProfileFieldChanged" />
                        <TextBlock Text="转速 (rpm)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ProfFirstRpm" Text="14500" Margin="0,0,0,6" LostFocus="OnProfileFieldChanged" />
                        <TextBlock Text="Plunge rate (mm/min)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ProfFirstPlunge" Text="1000" Margin="0,0,0,6" LostFocus="OnProfileFieldChanged" />
                        <CheckBox x:Name="ProfFirstRamp45" Content="45° 斜下刀" IsChecked="False"
                                  FontSize="12" Margin="0,0,0,6" Click="OnProfileFieldChanged" />
                        <TextBlock Text="余料厚度 (mm)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ProfFirstLeave" Text="0.5" Margin="0,0,0,12" LostFocus="OnProfileFieldChanged" />

                        <TextBlock Text="第二刀" FontSize="12" FontWeight="SemiBold" Foreground="#1A3A5C" Margin="0,0,0,6" />
                        <TextBlock Text="刀" FontSize="10" Foreground="#666" />
                        <ComboBox x:Name="ProfLastTool" Margin="0,0,0,6" SelectionChanged="OnProfileToolChanged" />
                        <TextBlock Text="Feedrate (mm/min)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ProfLastFeed" Text="20000" Margin="0,0,0,6" LostFocus="OnProfileFieldChanged" />
                        <TextBlock Text="转速 (rpm)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ProfLastRpm" Text="14500" Margin="0,0,0,6" LostFocus="OnProfileFieldChanged" />
                        <TextBlock Text="Plunge rate (mm/min)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ProfLastPlunge" Text="1000" Margin="0,0,0,6" LostFocus="OnProfileFieldChanged" />
                        <TextBlock Text="下探深度 (mm)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ProfLastThrough" Text="-0.55" Margin="0,0,0,12" LostFocus="OnProfileFieldChanged" />
                        <TextBlock Text="桥" FontSize="12" FontWeight="SemiBold" Foreground="#1A3A5C" Margin="0,0,0,6" />
                        <TextBlock Text="桥的宽度 (mm)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ProfBridgeWidth" Text="5" Margin="0,0,0,8" LostFocus="OnProfileFieldChanged"
                                 ToolTip="留下的桥心宽度。刀心再加两个刀半径，默认 5mm" />
                        <TextBlock Text="三桥面积上限 (m²)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ProfBridgeTinyArea" Text="0.1" Margin="0,0,0,6" LostFocus="OnProfileFieldChanged"
                                 ToolTip="小于此面积的小板放 3 座桥，且在不同边" />
                        <TextBlock Text="两桥 / 大板起点 (m²)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ProfBridgeLargeArea" Text="0.15" Margin="0,0,0,6" LostFocus="OnProfileFieldChanged"
                                 ToolTip="介于两数之间放 2 座；大于此面积算大板，不主动布" />
                        <TextBlock Text="条子长宽比" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ProfBridgeStripAspect" Text="12" Margin="0,0,0,8" LostFocus="OnProfileFieldChanged"
                                 ToolTip="长/宽大于此值算长条。默认 12" />
                        <Button x:Name="ProfBridgeManualBtn" Style="{StaticResource ProfModeBtn}"
                                Content="手动模式" Click="OnProfBridgeManualClick"
                                ToolTip="点外形刀路轨迹放桥；窄缝自动成对。再点退出" />
                        <Button x:Name="ProfBridgeDeleteBtn" Style="{StaticResource ProfModeBtn}"
                                Content="删除桥" Click="OnProfBridgeDeleteClick"
                                ToolTip="点已有桥删除；成对一起去掉。与手动模式不能同时开" />
                        <Button x:Name="ProfBridgeAutoBtn" Style="{StaticResource ProfModeBtn}"
                                Content="自动计算" Click="OnProfBridgeAutoClick"
                                ToolTip="当前大板：先小板长条，再纯长条，再补小板" />
                        <Button x:Name="ProfBridgeAutoAllBtn" Style="{StaticResource ProfModeBtn}"
                                Content="批量自动" Click="OnProfBridgeAutoAllClick"
                                ToolTip="所有大板上每一块板都按自动规则布桥；缺刀路会先算全部" />
                        <Button x:Name="ProfBridgeClearBtn" Style="{StaticResource ProfModeBtn}"
                                Content="清空本页" Click="OnProfBridgeClearClick"
                                ToolTip="去掉当前板所有桥，其它页保留" />
                        <TextBlock x:Name="ProfBridgeCount" Text="" FontSize="10" Foreground="#666" Margin="0,2,0,0" />
                      </StackPanel>
                      <StackPanel x:Name="OpsParamsClearance" Visibility="Collapsed">
                        <CheckBox x:Name="OpsClearanceChk" Content="清底 / 其它槽" IsChecked="True"
                                  FontSize="12" Margin="0,0,0,8" Click="OnCamStrategyEnableClick" />
                        <TextBlock Text="Feedrate (mm/min)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ClrFeed" Text="12000" Margin="0,0,0,6" LostFocus="OnClearanceFieldChanged" />
                        <TextBlock Text="转速 (rpm)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ClrRpm" Text="14500" Margin="0,0,0,6" LostFocus="OnClearanceFieldChanged" />
                        <TextBlock Text="Plunge rate (mm/min)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ClrPlunge" Text="1000" Margin="0,0,0,12" LostFocus="OnClearanceFieldChanged" />
                        <TextBlock Text="大刀最短边 (mm)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="ClrLargeMinShort" Text="17" Margin="0,0,0,8"
                                 LostFocus="OnClearanceThresholdChanged"
                                 ToolTip="短边 ≥ 此值用 T2 Ø10；更窄且还能进 Ø6.35 用 T1。铰链孔 / 铰杯一律 T2。" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666" Margin="0,0,0,8"
                                   Text="按短边自动选刀，不选手动刀号。槽看槽宽，口袋看外接矩形短边。直径 &lt; 5 mm 的孔才钻孔；Ø5 及以上（含铰杯）走清底。铰杯一律 T2 Ø10。刀路默认螺旋由里向外。进给按清底 F12000，不跟半槽。" />
                      </StackPanel>
                      <StackPanel x:Name="OpsParamsDrill" Visibility="Collapsed">
                        <CheckBox x:Name="OpsDrillChk" Content="钻孔" IsChecked="True"
                                  FontSize="12" Margin="0,0,0,8" Click="OnCamStrategyEnableClick" />
                        <TextBlock Text="Plunge rate (mm/min)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="DrillPlunge" Text="1000" Margin="0,0,0,6" LostFocus="OnDrillFieldChanged" />
                        <TextBlock Text="转速 (rpm)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="DrillRpm" Text="14500" Margin="0,0,0,12" LostFocus="OnDrillFieldChanged" />
                        <TextBlock Text="贯通下探 (mm)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="DrillThrough" Text="-0.55" Margin="0,0,0,12" LostFocus="OnDrillFieldChanged"
                                 ToolTip="只作用于通孔。盲孔深度跟特征，不在这里改。" />
                        <TextBlock Text="最大钻孔直径 (mm)" FontSize="10" Foreground="#666" />
                        <TextBox x:Name="DrillMaxExclusive" Text="5" Margin="0,0,0,8"
