<Window x:Class="CabinetNC.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="OmniCam"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1360" Height="860"
        MinWidth="1024" MinHeight="680"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="ColSplitter" TargetType="GridSplitter">
      <Setter Property="Width" Value="6" />
      <Setter Property="Background" Value="#C8C8C8" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="SizeWE" />
      <Setter Property="ShowsPreview" Value="False" />
      <Setter Property="Panel.ZIndex" Value="3" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1A3A5C" />
        </Trigger>
        <Trigger Property="IsDragging" Value="True">
          <Setter Property="Background" Value="#1A3A5C" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RailH2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#666666" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style x:Key="OpsIconBtn" TargetType="ToggleButton">
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="78" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="4,6" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#C8C8C8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="#1A3A5C" />
          <Setter Property="BorderBrush" Value="#1A3A5C" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="OpsRailCalcBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="4,8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="OpsRailCalcPrimaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="4,8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="ProfModeBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="StockChipBtn" TargetType="ToggleButton">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#AAAAAA" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="#1A3A5C" />
          <Setter Property="BorderBrush" Value="#1A3A5C" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Module rail button: HighlightModule() sets Background + a 3px left BorderThickness when active -->
    <Style x:Key="ModuleBtn" TargetType="Button">
      <Setter Property="Padding" Value="10,11" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#5EA1E6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="0,4,4,0" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#25385A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ModuleIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Foreground" Value="{StaticResource TextOnDarkMutedBrush}" />
    </Style>
    <ContextMenu x:Key="NestPartContextMenu">
      <MenuItem Header="改变材料" Click="OnNestChangeMaterialClick" />
      <MenuItem Header="改变纹路朝向 90°" Click="OnNestRotateGrainClick" />
    </ContextMenu>
    <ContextMenu x:Key="NestHoldContextMenu">
      <MenuItem Header="改变纹路朝向 90°" Click="OnNestRotateGrainClick" />
      <MenuItem Header="复制" Click="OnNestHoldCopyClick" />
      <MenuItem Header="删除" Click="OnNestHoldDeleteClick" />
    </ContextMenu>
  </Window.Resources>

  <DockPanel>
    <!-- Top chrome -->
    <Border DockPanel.Dock="Top" Padding="14,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource ChromeBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MinWidth="160" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
          <TextBlock Text="OmniCam" FontSize="16" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
          <TextBlock x:Name="ModuleSubtitle" Text="切割站 · 生产加工" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
        <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0" LastChildFill="True">
          <TextBlock DockPanel.Dock="Left" Text="工程" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox x:Name="ProjectNameBox" MinWidth="240" MaxWidth="360" Width="300"
                   HorizontalAlignment="Left" Padding="8,4" FontSize="13"
                   VerticalContentAlignment="Center"
                   ToolTip="工程名：保存工程默认用这个名字，导出 NC 也会带上"
                   TextChanged="OnProjectNameChanged"
                   LostFocus="OnProjectNameChanged" />
        </DockPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="打开方案…" Click="OnOpenClick" Style="{StaticResource PrimaryButton}"
                  ToolTip="打开 Fusion 导出的 .cnjob / woodjob / cut-package　(Ctrl+O)" />
          <Button Content="加入方案…" Click="OnAddPackageClick"
                  ToolTip="再打开一份或多份 .cnjob，和当前板件并列密排" />
          <Button Content="从 .anc 反推…" Click="OnImportAncClick"
                  ToolTip="从机台 OSAI .anc / .nc 还原板件，供补板重切" />
          <Rectangle Width="1" Height="22" Fill="{StaticResource BorderBrush}" Margin="4,0,10,0" />
          <Button Content="打开工程…" Click="OnOpenProjectClick" ToolTip="打开保存过的工程 (.db)　(Ctrl+Shift+O)" />
          <Button Content="保存工程" Click="OnSaveProjectClick" ToolTip="保存当前工程　(Ctrl+S)" />
          <Button x:Name="MoreMenuBtn" AutomationProperties.Name="更多" Click="OnMoreMenuClick" Style="{StaticResource GhostButton}" Margin="2,0,0,0"
                  ToolTip="诊断与帮助">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="更多" VerticalAlignment="Center" />
              <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="10" Margin="6,1,0,0" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu Placement="Bottom">
                <MenuItem Header="使用日志…" Click="OnOpenUsageLogsClick" ToolTip="打开 app_usage.jsonl / latest（问题排查）" />
                <MenuItem Header="计算引擎自检 (Ping)" Click="OnPingClick" />
                <Separator />
                <MenuItem Header="快捷键" Click="OnShortcutsClick" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="12,6" Background="#E9ECF1"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusGlyph" Grid.Column="0" Text="&#xE946;" Style="{StaticResource IconText}"
                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="就绪" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,0,12,0"
                   Foreground="{StaticResource TextBrush}" />
        <TextBlock x:Name="StatusTime" Grid.Column="2" Text="" VerticalAlignment="Center"
                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,0" />
        <ProgressBar x:Name="NestProgress" Grid.Column="3" Width="140" Height="6"
                     Margin="0,0,14,0" Minimum="0" Maximum="100" Value="0"
                     Visibility="Collapsed" VerticalAlignment="Center" />
        <TextBlock x:Name="ProjectNameBadge" Grid.Column="4" Text=""
                   VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource NavyBrush}"
                   FontWeight="SemiBold" Margin="0,0,14,0" TextTrimming="CharacterEllipsis"
                   MaxWidth="280" />
        <TextBlock x:Name="WorkerBadge" Grid.Column="5" Text="计算引擎 · 本地"
                   VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                   ToolTip="排版与刀路在本机计算。「更多 → 计算引擎自检」可检查独立 Worker 进程。" />
      </Grid>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="132" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left module rail (MakerHub) -->
      <Border Grid.Column="0" Background="{StaticResource RailBrush}" Padding="0,10,6,10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Button x:Name="ModProductionBtn" AutomationProperties.Name="生产加工" Style="{StaticResource ModuleBtn}" Tag="production" Click="OnModuleClick"
                    ToolTip="载入 → 板材 → 密排 → 刀路 → 导出">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7F8;" Style="{StaticResource ModuleIcon}" />
                <TextBlock Text="生产加工" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ModRemnantsBtn" AutomationProperties.Name="补板库" Style="{StaticResource ModuleBtn}" Tag="remnants" Click="OnModuleClick"
                    ToolTip="余料登记、从 .anc 反推重切">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B7;" Style="{StaticResource ModuleIcon}" />
                <TextBlock Text="补板库" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ModEquipmentBtn" AutomationProperties.Name="设备管理" Style="{StaticResource ModuleBtn}" Tag="equipment" Click="OnModuleClick"
                    ToolTip="机型目录与后置">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE770;" Style="{StaticResource ModuleIcon}" />
                <TextBlock Text="设备管理" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ModRoutesBtn" AutomationProperties.Name="路线管理" Style="{StaticResource ModuleBtn}" Tag="routes" Click="OnModuleClick"
                    ToolTip="工序开关与作业进度">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE9D5;" Style="{StaticResource ModuleIcon}" />
                <TextBlock Text="路线管理" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ModMaterialsBtn" AutomationProperties.Name="原料管理" Style="{StaticResource ModuleBtn}" Tag="materials" Click="OnModuleClick"
                    ToolTip="车间材料库">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8F1;" Style="{StaticResource ModuleIcon}" />
                <TextBlock Text="原料管理" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ModProcessBtn" AutomationProperties.Name="工艺模版" Style="{StaticResource ModuleBtn}" Tag="process" Click="OnModuleClick"
                    ToolTip="刀具库与进给模板">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE90F;" Style="{StaticResource ModuleIcon}" />
                <TextBlock Text="工艺模版" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ModSettingsBtn" AutomationProperties.Name="参数设置" Style="{StaticResource ModuleBtn}" Tag="settings" Click="OnModuleClick"
                    ToolTip="排版默认值、机床标签目录">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" Style="{StaticResource ModuleIcon}" />
                <TextBlock Text="参数设置" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Module bodies -->
      <Grid Grid.Column="1">
        <!-- ===== 生产加工 ===== -->
        <DockPanel x:Name="ProductionHost">
          <!-- Workflow chevron -->
          <Border DockPanel.Dock="Top" Background="#DDDDDD" BorderBrush="#B8B8B8" BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TabControl x:Name="StageTabs" Background="Transparent" BorderThickness="0" SelectionChanged="OnStageChanged">
                <TabControl.Resources>
                  <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="14,10" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="#444444" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                          <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent"
                                  BorderThickness="0,0,1,0" BorderBrush="#BBBBBB">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="White" />
                              <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,1,2" />
                              <Setter TargetName="Bd" Property="BorderBrush" Value="#2277CC" />
                              <Setter Property="Foreground" Value="#111111" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter Property="Foreground" Value="#999999" />
                              <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </TabControl.Resources>
                <TabItem x:Name="TabLoad" Tag="load" Header="1 载入方案" />
                <TabItem x:Name="TabStock" Tag="stock" Header="2 板材与设备" />
                <TabItem x:Name="TabNest" Tag="nest" Header="3 密排" />
                <TabItem x:Name="TabOps" Tag="ops" Header="4 刀路与加工档" />
                <TabItem x:Name="TabOut" Tag="out" Header="5 导出" />
              </TabControl>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel x:Name="WfDots" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center" />
                <Button x:Name="OneClickExportBtn" Content="一键导出" Click="OnOneClickExportClick" IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" Padding="12,5" MinHeight="28" Visibility="Collapsed"
                        ToolTip="按 Sheet×Tool 导出 NC + 每张大板 DXF/manifest + BOM/标签　(Ctrl+E)" />
              </StackPanel>
            </Grid>
          </Border>

          <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" Padding="12,7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="13"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                <TextBlock x:Name="StageHint" Text="先载入 woodjob / cut-package 方案"
                           Foreground="{StaticResource TextBrush}" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="AllowOverlapChk" Content="允许重叠" VerticalAlignment="Center" Margin="0,0,12,0"
                          Visibility="Collapsed" FontSize="12" />
                <Button x:Name="LockPlaceBtn" Content="锁定摆位" Click="OnLockPlaceClick" Visibility="Collapsed" Padding="10,3" MinHeight="26" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Stale banner: geometry changed after nest/CAM -->
          <Border x:Name="StaleBanner" DockPanel.Dock="Top" Style="{StaticResource InfoBar}" Visibility="Collapsed">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="重新密排" Click="OnStaleRenestClick"
                      Style="{StaticResource PrimaryButton}" Padding="12,4" MinHeight="26" Margin="12,0,0,0" />
              <Button x:Name="StaleGotoNestBtn" DockPanel.Dock="Right" Content="去密排页" Click="OnStaleGotoNestClick" Padding="10,4" MinHeight="26" Margin="8,0,0,0" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource WarningBrush}" Margin="0,0,8,0" />
                <TextBlock x:Name="StaleBannerText" Text="板件已修改，之前的密排与刀路已作废；导出前需要重新密排并生成刀路。"
                           Foreground="#7C3A00" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="LeftCol" Width="200" MinWidth="0" />
              <ColumnDefinition Width="*" MinWidth="240" />
              <ColumnDefinition x:Name="NcCol" Width="300" />
            </Grid.ColumnDefinitions>

            <GridSplitter x:Name="LeftSplitter" Grid.Column="0" Style="{StaticResource ColSplitter}" />

            <Border x:Name="LeftRail" Grid.Column="0" Background="#F7F7F7" BorderBrush="#C8C8C8" BorderThickness="0,0,1,0" Padding="8">
              <DockPanel>
                <Button x:Name="MergeKindsBtn" DockPanel.Dock="Bottom"
                        Content="合并" Click="OnMergeKindsClick"
                        Margin="0,10,0,0" Padding="10,6" HorizontalAlignment="Stretch"
                        Visibility="Collapsed" IsEnabled="False"
                        ToolTip="Ctrl 点选至少两个种类后，合并为其中一个材料" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LeftRailContent">
                  <TextBlock Text="工程" Style="{StaticResource RailH2}" Margin="0,0,0,4" />
                  <TextBlock x:Name="PackageMeta" Text="尚未加载" TextWrapping="Wrap" FontSize="12" Foreground="#888" Margin="0,0,0,8" />
                  <DockPanel Margin="0,10,0,4" LastChildFill="True">
                    <Button x:Name="CreatePanelBtn" DockPanel.Dock="Right"
                            Content="创建板件" Click="OnCreatePanelClick"
                            Padding="8,2" Margin="0" FontSize="11"
                            Visibility="Collapsed"
                            ToolTip="打开画布。已选板则载入该板，未选则新建。Profile=外框，Feature=孔/槽/口袋。" />
                    <TextBlock Text="板件" Style="{StaticResource RailH2}"
                               Margin="0" VerticalAlignment="Center" />
                  </DockPanel>
                  <ListBox x:Name="PartList" BorderThickness="0" Background="Transparent" SelectionChanged="OnPartSelected" FontSize="12"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           MouseDoubleClick="OnPartListDoubleClick">
                    <ListBox.GroupStyle>
                      <GroupStyle>
                        <GroupStyle.ContainerStyle>
                          <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                  <Expander IsExpanded="True" Margin="0,6,0,2"
                                            Foreground="#12314F" FontSize="12" FontWeight="Bold"
                                            PreviewMouseRightButtonUp="OnPackageGroupRightUp">
                                    <Expander.ContextMenu>
                                      <ContextMenu Opened="OnPackageGroupMenuOpened">
                                        <MenuItem Header="移出这份方案…" Click="OnRemovePackageClick" />
                                      </ContextMenu>
                                    </Expander.ContextMenu>
                                    <Expander.Header>
                                      <DockPanel>
                                        <CheckBox DockPanel.Dock="Left"
                                                  Tag="StockKindPick"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"
                                                  Focusable="False"
                                                  Visibility="{Binding StockKindPickerVisible, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  PreviewMouseLeftButtonDown="OnStockKindPickDown" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="#12314F" FontSize="12" FontWeight="Bold">
                                          <TextBlock.Text>
                                            <Binding Path="ItemCount" StringFormat=" ({0})" />
                                          </TextBlock.Text>
                                        </TextBlock>
                                        <Grid>
                                          <TextBlock Tag="KindName"
                                                     Text="{Binding Name}"
                                                     TextWrapping="Wrap"
                                                     VerticalAlignment="Center"
                                                     ToolTip="双击改名"
                                                     PreviewMouseLeftButtonDown="OnStockKindNameDown" />
                                          <TextBox Tag="KindRename"
                                                   Visibility="Collapsed"
                                                   Padding="2,1"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   PreviewMouseLeftButtonDown="OnStockKindRenameBoxDown"
                                                   LostFocus="OnStockKindRenameLostFocus"
                                                   KeyDown="OnStockKindRenameKey" />
                                        </Grid>
                                      </DockPanel>
                                    </Expander.Header>
                                    <ItemsPresenter Margin="0,2,0,0" />
                                  </Expander>
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </GroupStyle.ContainerStyle>
                      </GroupStyle>
                      <GroupStyle>
                        <GroupStyle.ContainerStyle>
                          <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                  <Expander IsExpanded="True" Margin="8,2,0,2"
                                            Foreground="#3A5A7A" FontSize="11" FontWeight="SemiBold">
                                    <Expander.Header>
                                      <TextBlock>
                                        <TextBlock.Text>
                                          <MultiBinding StringFormat="{}{0} ({1})">
                                            <Binding Path="Name" Mode="OneWay" />
                                            <Binding Path="ItemCount" Mode="OneWay" />
                                          </MultiBinding>
                                        </TextBlock.Text>
                                      </TextBlock>
                                    </Expander.Header>
                                    <ItemsPresenter Margin="4,2,0,0" />
                                  </Expander>
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </GroupStyle.ContainerStyle>
                      </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="8,1,0,3">
                          <TextBlock Text="{Binding DisplayPartName}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#222" />
                          <TextBlock Text="{Binding DisplayDetail}" TextWrapping="Wrap" FontSize="11" Foreground="#666" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="复制 (Ctrl+C)" Click="OnGeomDuplicateClick" />
                        <MenuItem Header="粘贴 (Ctrl+V)" Click="OnPastePanelClick" />
                        <MenuItem Header="剪切 (Ctrl+X)" Click="OnCutPanelClick" />
                        <MenuItem Header="创建板件" Click="OnCreatePanelClick" />
                        <MenuItem Header="删除整板 (Del)" Click="OnDeletePanelClick" />
                        <Separator />
                        <MenuItem Header="镜像 X" Click="OnGeomMirrorXClick" />
                        <MenuItem Header="镜像 Y" Click="OnGeomMirrorYClick" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                  </ListBox>
                  <TextBlock Text="告警" Style="{StaticResource RailH2}" />
                  <ListBox x:Name="WarnList" BorderThickness="0" Background="Transparent" FontSize="11" Foreground="#886644" />
                </StackPanel>
              </ScrollViewer>
              </DockPanel>
            </Border>

            <Border x:Name="OutGcodePane" Grid.Column="0" Background="#1E1E1E" BorderBrush="#C8C8C8"
                    BorderThickness="0,0,1,0" Visibility="Collapsed">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="G-code" Foreground="#CFCFCF" FontWeight="SemiBold"
                           Margin="12,10,12,6" />
                <TextBox x:Name="NcPreview" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"
                         Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0" Padding="10,4,10,10" />
              </DockPanel>
            </Border>

            <Border x:Name="CanvasPane" Grid.Column="1" Background="White"
                    PreviewMouseLeftButtonDown="OnCanvasDown"
                    PreviewMouseMove="OnCanvasMove"
                    PreviewMouseLeftButtonUp="OnCanvasUp"
                    PreviewMouseRightButtonDown="OnCanvasRightDown"
                    PreviewMouseRightButtonUp="OnCanvasRightUp"
                    PreviewMouseDown="OnCanvasPreviewDown"
                    PreviewMouseUp="OnCanvasPreviewUp"
                    PreviewMouseWheel="OnCanvasWheel"
                    LostMouseCapture="OnCanvasLostCapture">
              <Grid>
                <skia:SKElement x:Name="CanvasHost" PaintSurface="OnPaintSurface" />
                <Grid x:Name="NestCanvasChrome" Visibility="Collapsed">
                  <Border VerticalAlignment="Top" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,5">
                    <Grid>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NestSheetPrevBtn" Content="◀" Click="OnNestSheetPrevClick" Padding="8,2" Margin="0,0,6,0" />
                        <TextBlock x:Name="NestSheetLabel" Text="大板 1 / 1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                        <Button x:Name="NestSheetNextBtn" Content="▶" Click="OnNestSheetNextClick" Padding="8,2" Margin="6,0,0,0" />
                      </StackPanel>
                      <TextBlock x:Name="NestSheetMeta" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 FontSize="11" Foreground="#666" Text="" />
                    </Grid>
                  </Border>
                  <Button x:Name="NestCreatePanelBtn" Content="创建板件"
                          Click="OnNestCreatePanelClick"
                          HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          Margin="12,0,0,36" Padding="12,6" FontWeight="SemiBold"
                          ToolTip="按当前大板材料创建，完成后进入右侧待用区" />
                  <Border VerticalAlignment="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
                    <WrapPanel>
                      <TextBlock Text="选中" Foreground="#0066CC" FontSize="11" Margin="0,0,10,0" />
                      <TextBlock Text="锁定" Foreground="#886600" FontSize="11" Margin="0,0,10,0" />
                      <TextBlock Text="冲突" Foreground="#CC2222" FontSize="11" Margin="0,0,10,0" />
                      <TextBlock Text="Ctrl 多选" Foreground="#666" FontSize="11" Margin="0,0,10,0" />
                      <TextBlock Text="右侧=待用区" Foreground="#666" FontSize="11" Margin="0,0,10,0" />
                      <TextBlock Text="间距按板材种类" Foreground="#666" FontSize="11" />
                    </WrapPanel>
                  </Border>
                </Grid>
                <Grid x:Name="OutSimChrome" Visibility="Collapsed">
                  <Border VerticalAlignment="Top" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,5">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="OutSimTitle" Text="G-code 切割仿真" VerticalAlignment="Center"
                                 FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                      <TextBlock x:Name="OutSimMeta" Grid.Column="1" VerticalAlignment="Center"
                                 FontSize="11" Foreground="#666"
                                 Text="虚线空程 · 线宽=刀径 · 橙=留 0.5 · 蓝=通切" />
                    </Grid>
                  </Border>
                  <Border VerticalAlignment="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,6">
                    <DockPanel>
                      <Button x:Name="OutSimPlayBtn" Content="▶" Click="OnOutSimPlayClick"
                              Padding="12,2" DockPanel.Dock="Left" Margin="0,0,8,0"
                              ToolTip="播放 / 暂停" />
                      <Button Content="复位" Click="OnOutSimResetViewClick"
                              Padding="8,2" DockPanel.Dock="Left" Margin="0,0,8,0"
                              ToolTip="双击中键同样复位 · 滚轮对准指针缩放 · 中键平移" />
                      <ComboBox x:Name="OutSimSpeed" Width="68" DockPanel.Dock="Right"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                SelectedIndex="1" SelectionChanged="OnOutSimSpeedChanged">
                        <ComboBoxItem Content="1×" Tag="1" />
                        <ComboBoxItem Content="4×" Tag="4" />
                        <ComboBoxItem Content="16×" Tag="16" />
                      </ComboBox>
                      <TextBlock x:Name="OutSimTime" DockPanel.Dock="Right" VerticalAlignment="Center"
                                 FontSize="11" Foreground="#555" Margin="10,0,0,0" MinWidth="88"
                                 Text="0.0 / 0.0 s" />
                      <Slider x:Name="OutSimSlider" Minimum="0" Maximum="1000" Value="0"
                              VerticalAlignment="Center" Margin="0,2"
                              ValueChanged="OnOutSimSliderChanged" />
                    </DockPanel>
                  </Border>
                </Grid>
                <TextBlock x:Name="OutPreviewCaption" Visibility="Collapsed" IsHitTestVisible="False"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,12,0"
                           FontSize="12" FontWeight="SemiBold" Foreground="#1A3A5C" />
                <TextBlock x:Name="CanvasHint" Visibility="Collapsed" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" Foreground="#888" />
                <!-- Nest awaiting initial nest -->
                <Border x:Name="NestAwaitingState" Background="#FFFFFF" Visibility="Collapsed">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                    <TextBlock Text="&#xE8A9;" Style="{StaticResource IconText}" FontSize="36" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="尚未生成密排" Style="{StaticResource H1Text}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="先到「2 板材与设备」确认每种板材的大板尺寸与间距，再点「初始密排」。"
                               Style="{StaticResource SecondaryText}" TextAlignment="Center" Margin="0,0,0,18" FontSize="13" />
                    <Button Content="前往板材与设备" Click="OnGoStockForNestClick" Style="{StaticResource PrimaryButton}"
                            Padding="16,9" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <!-- Ops awaiting nest -->
                <Border x:Name="OpsAwaitingState" Background="#FFFFFF" Visibility="Collapsed">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                    <TextBlock Text="&#xE9F5;" Style="{StaticResource IconText}" FontSize="36" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="刀路需要先有密排" Style="{StaticResource H1Text}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="刀路按大板上每块板的实际位置计算。请先完成「3 密排」，再回到这里选机型并计算。"
                               Style="{StaticResource SecondaryText}" TextAlignment="Center" Margin="0,0,0,18" FontSize="13" />
                    <Button Content="前往密排" Click="OnStaleGotoNestClick" Style="{StaticResource PrimaryButton}"
                            Padding="16,9" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <!-- Out awaiting ops -->
                <Border x:Name="OutAwaitingState" Background="#FFFFFF" Visibility="Collapsed">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                    <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="36" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="还没有可导出的刀路" Style="{StaticResource H1Text}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock x:Name="OutAwaitingText" Text="到「4 刀路与加工档」点「计算全部」生成刀路后，这里会按大板列出可导出的程序文件。"
                               Style="{StaticResource SecondaryText}" TextAlignment="Center" Margin="0,0,0,18" FontSize="13" />
                    <Button x:Name="OutAwaitingBtn" Content="前往刀路" Click="OnGotoOpsClick" Style="{StaticResource PrimaryButton}"
                            Padding="16,9" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <!-- Empty state (no package) -->
                <Border x:Name="EmptyState" Background="#FFFFFF" Visibility="Visible">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="36" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="从一份方案开始" Style="{StaticResource H1Text}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="打开 Fusion 导出的 .cnjob，OmniCam 会带你走完板材 → 密排 → 刀路 → 导出五步。也支持 woodjob / cut-package，或直接从机台 .anc 反推补板重切。"
                               Style="{StaticResource SecondaryText}" TextAlignment="Center" Margin="0,0,0,18" FontSize="13" />
                    <WrapPanel HorizontalAlignment="Center">
                      <Button x:Name="EmptyLoadBtn" Content="打开方案…" Click="OnOpenClick" Style="{StaticResource PrimaryButton}" Padding="16,9" Margin="0,0,8,0" />
                      <Button x:Name="EmptyAncBtn" Content="从 .anc 反推…" Click="OnImportAncClick" Padding="14,9" Margin="0,0,8,0" />
                      <Button x:Name="EmptyDemoBtn" Content="打开示例" Click="OnLoadDemoClick" Style="{StaticResource GhostButton}" Padding="14,9" />
                    </WrapPanel>
                    <TextBlock Text="快捷键：Ctrl+O 打开方案 · Ctrl+S 保存工程 · Ctrl+1…5 切换步骤" Style="{StaticResource CaptionText}"
                               TextAlignment="Center" Margin="0,18,0,0" />
                  </StackPanel>
                </Border>
                <!-- Non-blocking notifications -->
                <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,12,14,0" Width="360" Panel.ZIndex="50" IsHitTestVisible="True" />
              </Grid>
            </Border>

            <!-- Geom rail (载入后检视/编辑) -->
            <Border x:Name="GeomPane" Grid.Column="2" Background="#F7F7F7" BorderBrush="#C8C8C8" BorderThickness="1,0,0,0" Padding="10" Visibility="Collapsed">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="检视 / 编辑" Style="{StaticResource RailH2}" Margin="0" />
                  <TextBlock x:Name="GeomMeta" Text="选板后可编辑" TextWrapping="Wrap" FontSize="12" Foreground="#555" Margin="0,0,0,8" />
                  <TextBlock x:Name="DirtyBanner" Text="" TextWrapping="Wrap" FontSize="11" Foreground="#B45309" Margin="0,0,0,8" Visibility="Collapsed" />
                  <WrapPanel Margin="0,0,0,8">
                    <Button Content="特征→10" Click="OnGeomMoveClick" Padding="8,4" Margin="0,0,4,4" />
                    <Button Content="旋转90°" Click="OnGeomRotClick" Padding="8,4" Margin="0,0,4,4" />
                    <Button Content="+孔⌀8" Click="OnGeomHoleClick" Padding="8,4" Margin="0,0,4,4" />
                    <Button Content="+槽" Click="OnGeomGrooveClick" Padding="8,4" Margin="0,0,4,4" />
                    <Button Content="镜像X" Click="OnGeomMirrorXClick" Padding="8,4" Margin="0,0,4,4" />
                    <Button Content="镜像Y" Click="OnGeomMirrorYClick" Padding="8,4" Margin="0,0,4,4" />
                    <Button Content="复制板" Click="OnGeomDuplicateClick" Padding="8,4" Margin="0,0,4,4" />
                    <Button Content="删特征" Click="OnGeomDeleteFeatureClick" Padding="8,4" Margin="0,0,4,4" />
                    <Button Content="撤销" Click="OnUndoClick" Padding="8,4" Margin="0,0,4,4" />
                    <Button Content="重做" Click="OnRedoClick" Padding="8,4" Margin="0,0,4,4" />
                  </WrapPanel>
                  <TextBlock x:Name="SmallPanelWarn" Text="" TextWrapping="Wrap" FontSize="11" Foreground="#B91C1C" Margin="0,0,0,8" Visibility="Collapsed" />
                  <TextBlock Text="特征" Style="{StaticResource RailH2}" />
                  <ListBox x:Name="FeatList" BorderThickness="0" Background="Transparent" FontSize="12" MinHeight="60"
                           SelectionChanged="OnFeatListChanged">
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="复制板件 (Ctrl+C)" Click="OnGeomDuplicateClick" />
                        <MenuItem Header="粘贴板件 (Ctrl+V)" Click="OnPastePanelClick" />
                        <MenuItem Header="剪切板件 (Ctrl+X)" Click="OnCutPanelClick" />
                        <Separator />
                        <MenuItem Header="镜像 X" Click="OnGeomMirrorXClick" />
                        <MenuItem Header="镜像 Y" Click="OnGeomMirrorYClick" />
                        <MenuItem Header="删除特征 (Del)" Click="OnGeomDeleteFeatureClick" />
                        <MenuItem Header="删除整板" Click="OnDeletePanelClick" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                  </ListBox>
                  <Border Background="#EEE" Padding="8" Margin="0,8,0,0" CornerRadius="4">
                    <StackPanel>
                      <TextBlock Text="特征 Inspector" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                      <TextBlock x:Name="InspKind" Text="未选特征" FontSize="11" Foreground="#555" Margin="0,0,0,6" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="X / 直径 mm" FontSize="10" Foreground="#666" />
                          <TextBox x:Name="InspXBox" Margin="0,0,0,4" />
                          <TextBox x:Name="InspDiaBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Y / 深度·宽度 mm" FontSize="10" Foreground="#666" />
                          <TextBox x:Name="InspYBox" Margin="0,0,0,4" />
                          <TextBox x:Name="InspDepthBox" Margin="0,0,0,4" />
                          <TextBox x:Name="InspWidthBox" />
                        </StackPanel>
                      </Grid>
                      <Button Content="应用特征参数" Click="OnInspectApplyClick" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Border>

            <!-- Stock rail: one parameter box per cnjob material kind -->
            <Border x:Name="StockPane" Grid.Column="2" Background="#F7F7F7" BorderBrush="#C8C8C8" BorderThickness="1,0,0,0" Padding="10" Visibility="Collapsed">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                  <TextBlock Text="板材与设备" Style="{StaticResource RailH2}" Margin="0" />
                  <TextBlock Text="每种板材单独设大板尺寸。Use leftover 后填余料 X/Y，密排第一张是这块余料（贴原点）；大板边距只落在仍是外沿的边，锯开的边不加边距。"
                             TextWrapping="Wrap" FontSize="11" Foreground="#666" Margin="0,2,0,8" />
                  <TextBlock Text="机型" FontSize="11" Foreground="#555" />
                  <ComboBox x:Name="StockMachineCombo" DisplayMemberPath="Name" SelectedValuePath="Id"
                            Margin="0,0,0,4" SelectionChanged="OnStockMachineChanged" />
                  <TextBlock Text="贴标机" FontSize="11" Foreground="#555" />
                  <ComboBox x:Name="StockLabelerCombo" DisplayMemberPath="Name" SelectedValuePath="Id"
                            Margin="0,0,0,4" SelectionChanged="OnStockLabelerChanged" />
                </StackPanel>
                <TextBlock x:Name="StockPaneEmpty" DockPanel.Dock="Top"
                           Text="载入方案后，这里会按板材种类列出参数框。"
                           TextWrapping="Wrap" Foreground="#888" FontSize="12" Margin="0,8,0,0" />
                <Button x:Name="StockInitialNestBtn" DockPanel.Dock="Bottom"
                        Content="初始密排 →" Click="OnStockInitialNestClick"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,10,0,0" Padding="12,9"
                        HorizontalAlignment="Stretch"
                        ToolTip="按当前各板材尺寸生成第一版密排，然后自动进入「3 密排」微调" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="StockMaterialCards">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="10,8" Background="#FFFFFF"
                                BorderBrush="#C8C8C8" BorderThickness="1">
                          <StackPanel>
                            <TextBlock Text="种类名" FontSize="10" Foreground="#666" />
                            <TextBox Text="{Binding Label, UpdateSourceTrigger=LostFocus}"
                                     LostFocus="OnStockKindLabelChanged"
                                     ToolTip="{Binding AutoLabel}"
                                     Margin="0,0,0,4" FontWeight="SemiBold" />
                            <TextBlock Margin="0,0,0,6" FontSize="11" Foreground="#666">
                              <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} · {1} 件">
                                  <Binding Path="MaterialId" />
                                  <Binding Path="PanelCount" />
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <StackPanel>
                                <TextBlock Text="板宽 mm" FontSize="10" Foreground="#666" />
                                <TextBox Text="{Binding WidthMmText, UpdateSourceTrigger=PropertyChanged}" />
                              </StackPanel>
                              <StackPanel Grid.Column="2">
                                <TextBlock Text="板长 mm" FontSize="10" Foreground="#666" />
                                <TextBox Text="{Binding LengthMmText, UpdateSourceTrigger=PropertyChanged}" />
                              </StackPanel>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <StackPanel>
                                <TextBlock Text="密排间距 mm" FontSize="10" Foreground="#666" />
                                <TextBox Text="{Binding SpacingMmText, UpdateSourceTrigger=PropertyChanged}" />
                              </StackPanel>
                              <StackPanel Grid.Column="2">
                                <TextBlock Text="边缘距离 mm" FontSize="10" Foreground="#666" />
                                <TextBox Text="{Binding BorderMmText, UpdateSourceTrigger=PropertyChanged}" />
                              </StackPanel>
                            </Grid>
                            <CheckBox Content="允许90度旋转" IsChecked="{Binding AllowRotate90}"
                                      Margin="0,8,0,2" FontSize="12" />
                            <TextBlock Text="大板木纹" FontSize="10" Foreground="#666" Margin="0,6,0,0" />
                            <ComboBox ItemsSource="{Binding SheetGrainChoices}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding SheetGrainKey, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,6"
                                      SelectionChanged="OnStockSheetGrainChanged"
                                      ToolTip="Fusion 设定板件木纹；这里设大板纹理方向。无纹理则不强制对齐。" />
                            <Expander Header="{Binding PanelGrainHeader}"
                                      IsExpanded="{Binding PanelGrainsExpanded, Mode=TwoWay}"
                                      Margin="0,2,0,6"
                                      FontSize="12"
                                      ToolTip="默认收起。点开后可改单块板的木纹。">
                              <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                <ItemsControl ItemsSource="{Binding PanelGrains}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <DockPanel Margin="0,0,0,3" LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right" Width="64" Margin="8,0,0,0"
                                                  ItemsSource="{Binding GrainChoices}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Key"
                                                  SelectedValue="{Binding GrainKey, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="OnStockPanelGrainChanged" />
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" FontSize="12" />
                                      </DockPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </ScrollViewer>
                            </Expander>
                            <CheckBox Content="允许 parts in part" IsChecked="{Binding AllowPartsInPart}"
                                      Margin="0,0,0,2" FontSize="12"
                                      ToolTip="零件嵌套进另一零件的空洞（引擎预留；勾选后写入本材料密排参数）" />
                            <ToggleButton Style="{StaticResource StockChipBtn}"
                                          Content="Use leftover"
                                          IsChecked="{Binding UseLeftoverPieces}"
                                          ToolTip="打开后填余料 X/Y。密排第一张用这块余料，默认贴原点；放不下再开整张大板。" />
                            <Grid Margin="0,6,0,0">
                              <Grid.Style>
                                <Style TargetType="Grid">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseLeftoverPieces}" Value="True">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Grid.Style>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <StackPanel>
                                <TextBlock Text="余料 X mm" FontSize="10" Foreground="#666" />
                                <TextBox Text="{Binding LeftoverXMmText, UpdateSourceTrigger=PropertyChanged}" />
                              </StackPanel>
                              <StackPanel Grid.Column="2">
                                <TextBlock Text="余料 Y mm" FontSize="10" Foreground="#666" />
                                <TextBox Text="{Binding LeftoverYMmText, UpdateSourceTrigger=PropertyChanged}" />
                              </StackPanel>
                            </Grid>
                            <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="#888"
                                       Text="{Binding LeftoverHint}" />
                            <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#888"
                                       Text="{Binding ThicknessHint}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>

            <!-- Nest rail -->
            <Border x:Name="NestPane" Grid.Column="2" Background="#F7F7F7" BorderBrush="#C8C8C8" BorderThickness="1,0,0,0" Padding="10" Visibility="Collapsed">
              <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
