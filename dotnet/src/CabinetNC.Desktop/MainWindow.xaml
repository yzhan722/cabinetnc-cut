                  <Button x:Name="OutExportKindBtn" Content="导出当前板材种类" Click="OnExportKindClick"
                          Padding="8,6" Margin="0,0,0,6" IsEnabled="False"
                          ToolTip="导出选中文件同一板材种类的全部大板，例如全部 15mm 匣体" />
                  <Button x:Name="OutExportAllBtn" Content="导出全部" Click="OnExportAllClick"
                          Style="{StaticResource PrimaryButton}"
                          Padding="8,8" Margin="0,0,0,10" IsEnabled="False"
                          ToolTip="导出所有大板的程序文件与标签 BMP 到一个目录" />
                  <Button x:Name="OutExportDxfSheetBtn" Content="单独导出这张大板 DXF"
                          Click="OnExportDxfSheetClick"
                          Padding="8,6" Margin="0,0,0,6" IsEnabled="False"
                          ToolTip="把当前选中的大板排版写成一份 DXF，给 Carveco 演算" />
                  <Button x:Name="OutExportDxfKindBtn" Content="按照种类导出 DXF"
                          Click="OnExportDxfKindClick"
                          Padding="8,6" IsEnabled="False"
                          ToolTip="同一板材种类的每张大板各一份 DXF" />
                </StackPanel>
                <ListBox x:Name="OutFileList" BorderThickness="0" Background="Transparent"
                         Padding="6,0,6,8" FontSize="12"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnOutFileSelected">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="4,6,4,8">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#222" />
                        <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="#666" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#888" Margin="0,1,0,0" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
          </Grid>
        </DockPanel>

        <!-- ===== 补板库 ===== -->
        <Border x:Name="RemnantsHost" Background="{StaticResource PanelBrush}" Visibility="Collapsed" Padding="20,16">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <TextBlock Text="补板库" Style="{StaticResource H1Text}" Margin="0,0,0,4" />
              <TextBlock Text="从机台 .anc 反推出板件后，勾选要重切的块（数量改为 1），再回生产加工密排导出。"
                         Style="{StaticResource SecondaryText}" />
              <TextBlock x:Name="RemnantsMeta" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12" />
              <TextBlock Text="重切板件" FontWeight="SemiBold" Margin="0,12,0,4" />
              <ListBox x:Name="RecutPanelList" MinHeight="80" MaxHeight="180" FontSize="12" Margin="0,0,0,6">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected, Mode=TwoWay}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel Margin="0,0,0,12">
                <Button Content="从 .anc 反推…" Click="OnImportAncClick" Margin="0,0,8,0" />
                <Button Content="重切勾选的板" Click="OnRecutSelectedClick" />
              </WrapPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <TextBlock Text="登记补板" FontWeight="SemiBold" Margin="0,0,0,6" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="RemWBox" ToolTip="宽 mm" Text="600" />
                <TextBox Grid.Column="2" x:Name="RemLBox" ToolTip="长 mm" Text="400" />
                <TextBox Grid.Column="4" x:Name="RemTBox" ToolTip="厚 mm" Text="18" />
                <TextBox Grid.Column="6" x:Name="RemMatBox" ToolTip="材料" Text="" />
              </Grid>
              <WrapPanel Margin="0,8,0,0">
                <Button Content="添加补板" Click="OnRemnantAddClick" />
                <Button Content="从当前板材添加" Click="OnRemnantFromSheetClick" />
                <Button Content="切换参与密排" Click="OnRemnantToggleNestClick" />
                <Button Content="删除选中" Click="OnRemnantDeleteClick" />
                <Button Content="保存库" Click="OnLibrarySaveClick" />
              </WrapPanel>
            </StackPanel>
            <ListBox x:Name="RemnantsList" FontSize="12" />
          </DockPanel>
        </Border>

        <!-- ===== 设备管理 ===== -->
        <Border x:Name="EquipmentHost" Background="{StaticResource PanelBrush}" Visibility="Collapsed" Padding="20,16">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <TextBlock Text="设备管理" Style="{StaticResource H1Text}" Margin="0,0,0,4" />
              <TextBlock Text="后置机型目录。选中后用于 Nest / NC 输出。"
                         Style="{StaticResource SecondaryText}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <TextBlock Text="当前机型" FontSize="11" Foreground="#555" />
              <ComboBox x:Name="MachineComboModule" DisplayMemberPath="Name" SelectedValuePath="Id" Width="320"
                        HorizontalAlignment="Left" SelectionChanged="OnMachineModuleChanged" Margin="0,0,0,8" />
              <Button Content="应用到生产加工" Click="OnEquipmentApplyClick" HorizontalAlignment="Left" />
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ListBox x:Name="EquipmentList" FontSize="12" SelectionChanged="OnEquipmentListChanged" />
              <TextBox Grid.Column="1" x:Name="EquipmentDetail" IsReadOnly="True" AcceptsReturn="True"
                       FontFamily="Consolas" FontSize="12" Margin="12,0,0,0" BorderThickness="1"
                       VerticalScrollBarVisibility="Auto" />
            </Grid>
          </DockPanel>
        </Border>

        <!-- ===== 路线管理 ===== -->
        <Border x:Name="RoutesHost" Background="{StaticResource PanelBrush}" Visibility="Collapsed" Padding="20,16">
          <ScrollViewer>
            <StackPanel>
              <TextBlock Text="路线管理" Style="{StaticResource H1Text}" Margin="0,0,0,4" />
              <TextBlock Text="生产路线 = 载入→板材设备→密排→刀路加工档→导出。下列为当前作业进度与机型工序开关。"
                         Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
              <TextBlock x:Name="RoutesMeta" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
              <TextBlock Text="工序开关（当前机型）" FontWeight="SemiBold" Margin="0,0,0,6" />
              <CheckBox x:Name="RouteTongueChk" Content="半槽 T1（插 tongue）" Margin="0,0,0,4" Click="OnCamStrategyEnableClick" />
              <CheckBox x:Name="RouteGrooveChk" Content="清底 / 其它槽" Margin="0,0,0,4" Click="OnCamStrategyEnableClick" />
              <CheckBox x:Name="RouteContourChk" Content="外形两刀 T2" Margin="0,0,0,4" Click="OnCamStrategyEnableClick" />
              <CheckBox x:Name="RouteDrillChk" Content="钻孔" Margin="0,0,0,12" Click="OnCamStrategyEnableClick" />
              <TextBlock Text="当前作业工序摘要" FontWeight="SemiBold" Margin="0,0,0,6" />
              <ListBox x:Name="RoutesOpsList" FontSize="12" MinHeight="160" />
              <Button Content="进入生产加工" Click="OnGotoProductionClick" HorizontalAlignment="Left" Margin="0,12,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- ===== 原料管理 ===== -->
        <Border x:Name="MaterialsHost" Background="{StaticResource PanelBrush}" Visibility="Collapsed" Padding="20,16">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="原料管理" Style="{StaticResource H1Text}" Margin="0,0,0,4" />
              <TextBlock Text="车间材料库 + 当前方案板材。库持久化到 %LocalAppData%/CabinetNC/library.json。"
                         Style="{StaticResource SecondaryText}" />
              <TextBlock x:Name="MaterialsMeta" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <TextBlock Text="添加材料" FontWeight="SemiBold" Margin="0,0,0,6" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" /><ColumnDefinition Width="6" />
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MatNameBox" ToolTip="名称" Text="new_mat" />
                <TextBox Grid.Column="2" x:Name="MatThickBox" ToolTip="厚度" Text="18" />
                <TextBox Grid.Column="4" x:Name="MatHintBox" ToolTip="类型提示" Text="板式" />
              </Grid>
              <WrapPanel Margin="0,8,0,0">
                <Button Content="添加材料" Click="OnMaterialAddClick" />
                <Button Content="删除选中库材料" Click="OnMaterialDeleteClick" />
                <Button Content="从方案同步材料" Click="OnMaterialSyncPackageClick" />
                <Button Content="保存库" Click="OnLibrarySaveClick" />
              </WrapPanel>
            </StackPanel>
            <ListBox x:Name="MaterialsList" FontSize="12" />
          </DockPanel>
        </Border>

        <!-- ===== 工艺模版 ===== -->
        <Border x:Name="ProcessHost" Background="{StaticResource PanelBrush}" Visibility="Collapsed" Padding="20,16">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="工艺模版" Style="{StaticResource H1Text}" Margin="0,0,0,4" />
              <TextBlock Text="刀具库与进给模板。可按机型生成默认刀，并查看当前作业工序。"
                         Style="{StaticResource SecondaryText}" />
              <TextBlock x:Name="ProcessMeta" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <TextBlock Text="添加 / 更新刀具" FontWeight="SemiBold" Margin="0,0,0,6" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" /><ColumnDefinition Width="6" />
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ToolNameBox" ToolTip="名称" Text="router" />
                <TextBox Grid.Column="2" x:Name="ToolDiaBox" ToolTip="直径" Text="6" />
                <TextBox Grid.Column="4" x:Name="ToolFeedXyBox" ToolTip="进给 XY" Text="4000" />
                <TextBox Grid.Column="6" x:Name="ToolRpmBox" ToolTip="转速" Text="18000" />
              </Grid>
              <WrapPanel Margin="0,8,0,0">
                <Button Content="添加刀具" Click="OnToolAddClick" />
                <Button x:Name="ToolApplyBtn" Content="应用选中到当前加工" Click="OnToolApplyClick" />
                <Button Content="删除选中" Click="OnToolDeleteClick" />
                <Button Content="从机型重置刀具" Click="OnToolResetFromMachinesClick" />
                <Button Content="保存库" Click="OnLibrarySaveClick" />
              </WrapPanel>
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <DockPanel Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="刀具库" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ListBox x:Name="ProcessToolsList" FontSize="12" SelectionChanged="OnProcessToolSelected" />
              </DockPanel>
              <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="当前作业工序" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ListBox x:Name="ProcessOpsList" FontSize="12" />
              </DockPanel>
            </Grid>
          </DockPanel>
        </Border>

        <!-- ===== 参数设置 ===== -->
        <Border x:Name="SettingsHost" Background="{StaticResource PanelBrush}" Visibility="Collapsed" Padding="20,16">
          <ScrollViewer>
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
              <TextBlock Text="参数设置" Style="{StaticResource H1Text}" Margin="0,0,0,4" />
              <TextBlock Text="排版默认值与车间偏好。保存后写入 library.json；可一键应用到当前生产加工。"
                         Style="{StaticResource SecondaryText}" Margin="0,0,0,14" />

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="排版默认值" Style="{StaticResource H2Text}" Margin="0,0,0,8" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="默认板宽 mm" Style="{StaticResource FieldLabel}" />
                      <TextBox x:Name="SetSheetWBox" Margin="0,0,0,8" />
                      <TextBlock Text="默认间距 mm" Style="{StaticResource FieldLabel}" />
                      <TextBox x:Name="SetSpacingBox" Margin="0,0,0,8" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="默认板长 mm" Style="{StaticResource FieldLabel}" />
                      <TextBox x:Name="SetSheetLBox" Margin="0,0,0,8" />
                      <TextBlock Text="默认边距 mm" Style="{StaticResource FieldLabel}" />
                      <TextBox x:Name="SetBorderBox" Margin="0,0,0,8" />
                    </StackPanel>
                  </Grid>
                  <CheckBox x:Name="SetAllowRotChk" Content="默认允许旋转排版" Margin="0,2,0,0" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="机床与贴标" Style="{StaticResource H2Text}" Margin="0,0,0,4" />
                  <TextBlock Text="导出的标签 BMP 必须直接放在贴标软件的「Print picture path」目录里（不能有子目录）。这里填机床电脑上的那个目录，导出提示会照此显示。"
                             Style="{StaticResource SecondaryText}" Margin="0,0,0,8" />
                  <TextBlock Text="机床标签图片目录" Style="{StaticResource FieldLabel}" />
                  <TextBox x:Name="SetLabelDirBox" Margin="0,0,0,4" ToolTip="现场默认 D:\CNC（2026-08-19 事故复盘确认）" />
                  <TextBlock Text="OSAI 单文件后置：Z0 = 板底 / 垫板上表面，安全高 30，留皮 0.5，穿透 −0.55，每把刀 M6 自动换刀。这些数值在「4 刀路与加工档」右侧可按作业调整。"
                             Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                </StackPanel>
              </Border>

              <TextBlock x:Name="SettingsMeta" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" />
              <WrapPanel>
                <Button Content="保存参数" Click="OnSettingsSaveClick" Style="{StaticResource PrimaryButton}" />
                <Button Content="应用到生产加工" Click="OnSettingsApplyClick" />
                <Button Content="恢复默认" Click="OnSettingsResetClick" Style="{StaticResource GhostButton}" />
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
