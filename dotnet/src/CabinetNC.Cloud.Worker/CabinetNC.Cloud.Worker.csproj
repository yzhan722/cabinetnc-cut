<Project Sdk="Microsoft.NET.Sdk">

  <!-- Intranet compute worker: claims jobs from PostgreSQL, runs the shared Compute.Core runner,
       stores results in the object store. This is the only cloud process that references the
       nesting engine. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CabinetNC.Cloud.Contracts\CabinetNC.Cloud.Contracts.csproj" />
    <ProjectReference Include="..\CabinetNC.Cloud.Infrastructure\CabinetNC.Cloud.Infrastructure.csproj" />
    <ProjectReference Include="..\CabinetNC.Compute.Core\CabinetNC.Compute.Core.csproj" />
  </ItemGroup>

</Project>
