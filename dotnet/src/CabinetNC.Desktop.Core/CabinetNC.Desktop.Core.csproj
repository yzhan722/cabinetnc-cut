<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI logic that does not need WPF: testable on Linux, referenced by CabinetNC.Desktop.
       Rule (guarded by Desktop.Core.Tests): no reference to PresentationFramework /
       PresentationCore / WindowsBase / System.Xaml. -->

  <ItemGroup>
    <ProjectReference Include="..\CabinetNC.Domain\CabinetNC.Domain.csproj" />
    <ProjectReference Include="..\CabinetNC.Infrastructure\CabinetNC.Infrastructure.csproj" />
    <!-- Cloud/ : intranet client. Contracts are DTOs only; Compute.Contracts is the local gRPC worker surface. -->
    <ProjectReference Include="..\CabinetNC.Cloud.Contracts\CabinetNC.Cloud.Contracts.csproj" />
    <ProjectReference Include="..\CabinetNC.Compute.Contracts\CabinetNC.Compute.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DPAPI for the refresh token at rest (Windows only; guarded with SupportedOSPlatform). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
